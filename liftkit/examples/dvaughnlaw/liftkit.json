{
 "_about": "Reference config reproducing the Vaughn Law pipeline (WordPress + Divi). The live project in dvaughnlaw/ predates liftkit.json and keeps its own copy of the scripts in dvaughnlaw/tools/; copy this file to a project folder to run the shared tools against it.",
 "name": "Vaughn Law",
 "readme_title": "dvaughnlaw.com",
 "domain": "dvaughnlaw.com",
 "source": {
  "primary": "https://dvaughnlaw.com"
 },
